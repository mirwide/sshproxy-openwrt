#!/bin/sh /etc/rc.common
#
# sshproxy - transparent SSH proxy: redirects traffic to subnets
# through an SSH tunnel. The daemon installs netfilter rules on start and
# removes them on stop.
#
# /etc/config/sshproxy holds only the path to the JSON config; all settings
# (SSH, listen, subnets, firewall backend) live in that file.
#

START=95
STOP=10

USE_PROCD=1

PROG=/usr/bin/sshproxy
DEFAULT_CONFIG=/etc/sshproxy/config.json

config_file() {
    config_load sshproxy
    local path
    config_get path 'sshproxy' 'config' "$DEFAULT_CONFIG"
    echo "$path"
}

start_service() {
    local enabled
    config_load sshproxy
    config_get_bool enabled 'sshproxy' 'enabled' '1'
    [ "$enabled" = "1" ] || return 1

    local path
    path=$(config_file)
    [ -s "$path" ] || {
        logger -t sshproxy "config file $path is missing or empty"
        return 1
    }

    procd_open_instance
    procd_set_param command "$PROG" "$path" daemon
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    # Демон удаляет правила при SIGTERM, но teardown идемпотентен и
    # служит страховкой на случай kill -9 или сбоя процесса.
    local path
    path=$(config_file)
    "$PROG" "$path" teardown >/dev/null 2>&1
}

service_triggers() {
    procd_add_reload_trigger sshproxy
}
