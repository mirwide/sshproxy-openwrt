{
	"admin/services/sshproxy": {
		"title": "SSHProxy",
		"order": 60,
		"action": {
			"type": "alias",
			"path": "admin/services/sshproxy/service"
		},
		"depends": {
			"acl": [ "luci-app-sshproxy" ],
			"fs": {
				"/etc/init.d/sshproxy": "executable"
			},
			"uci": { "sshproxy": true }
		}
	},

	"admin/services/sshproxy/service": {
		"title": "Service",
		"order": 10,
		"action": {
			"type": "view",
			"path": "sshproxy/service"
		}
	},

	"admin/services/sshproxy/settings": {
		"title": "Settings",
		"order": 20,
		"action": {
			"type": "view",
			"path": "sshproxy/settings"
		}
	},

	"admin/services/sshproxy/log": {
		"title": "Log Viewer",
		"order": 30,
		"action": {
			"type": "view",
			"path": "sshproxy/log"
		}
	}
}
